  "components": {
    "securitySchemes": {
      "deviceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Id",
        "description": "接口还需要同时传 X-Device-Secret。Apifox 中可在全局 Header 再配置 X-Device-Secret。"
      }
    },
    "parameters": {
      "FamilyCodeQuery": {
        "name": "familyCode",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 100,
          "example": "fam_xxx"
        }
      },
      "ItemIdQuery": {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 100,
          "example": "shop_tomato"
        }
      },
      "SinceQuery": {
        "name": "since",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64",
          "default": 0,
          "example": 0
        }
      },
      "CategoryQuery": {
        "name": "category",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "description": "按条目 JSON 里的 category 分类筛选"
      },
      "CategoryIdQuery": {
        "name": "categoryId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "description": "按条目 JSON 里的 categoryId 或 category_id 分类筛选"
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "错误响应",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "familyCode is required"
            }
          }
        }
      }
    },
    "schemas": {
      "RegisterDeviceRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 100,
            "example": "dev_abc"
          },
          "deviceSecret": {
            "type": "string",
            "maxLength": 200,
            "example": "设备密钥"
          }
        }
      },
      "CreateFamilyRequest": {
        "type": "object",
        "properties": {
          "familyName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "example": "苏明明的厨房"
          }
        }
      },
      "UpdateFamilyRequest": {
        "type": "object",
        "required": [
          "familyCode"
        ],
        "properties": {
          "familyCode": {
            "type": "string",
            "maxLength": 100,
            "example": "fam_xxx"
          },
          "familyName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "example": "新的家庭名"
          }
        }
      },
      "FamilyCodeBody": {
        "type": "object",
        "required": [
          "familyCode"
        ],
        "properties": {
          "familyCode": {
            "type": "string",
            "maxLength": 100,
            "example": "fam_xxx"
          }
        }
      },
      "CreateFamilyInviteRequest": {
        "type": "object",
        "required": [
          "familyCode"
        ],
        "properties": {
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "ttlMinutes": {
            "type": "integer",
            "default": 60,
            "example": 60
          }
        }
      },
      "JoinFamilyRequest": {
        "type": "object",
        "required": [
          "inviteCode"
        ],
        "properties": {
          "inviteCode": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "SaveFamilyRecipeRequest": {
        "type": "object",
        "required": [
          "familyCode",
          "recipeJson"
        ],
        "properties": {
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "recipeJson": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "recipes": []
            }
          }
        }
      },
      "SaveShoppingItemRequest": {
        "type": "object",
        "required": [
          "familyCode",
          "shoppingItemJson"
        ],
        "properties": {
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "shoppingItemJson": {
            "$ref": "#/components/schemas/CollectionItem"
          }
        }
      },
      "SaveIngredientItemRequest": {
        "type": "object",
        "required": [
          "familyCode",
          "ingredientItemJson"
        ],
        "properties": {
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "ingredientItemJson": {
            "$ref": "#/components/schemas/CollectionItem"
          }
        }
      },
      "DeleteItemRequest": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "example": "shop_tomato"
          }
        }
      },
      "Family": {
        "type": "object",
        "properties": {
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "familyName": {
            "type": "string",
            "nullable": true,
            "example": "苏明明的厨房"
          },
          "createdByDeviceId": {
            "type": "string",
            "example": "dev_abc"
          }
        },
        "additionalProperties": true
      },
      "Member": {
        "type": "object",
        "properties": {
          "memberCode": {
            "type": "string",
            "example": "dev_abc"
          },
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "deviceId": {
            "type": "string",
            "example": "dev_abc"
          },
          "role": {
            "type": "string",
            "example": "owner"
          },
          "joinedFamily": {
            "type": "boolean",
            "example": true
          }
        },
        "additionalProperties": true
      },
      "Invite": {
        "type": "object",
        "properties": {
          "familyCode": {
            "type": "string",
            "example": "fam_xxx"
          },
          "inviteCode": {
            "type": "string",
            "example": "123456"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-12T07:28:49.000Z"
          }
        },
        "additionalProperties": true
      },
      "CollectionItem": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "shop_tomato"
          },
          "name": {
            "type": "string",
            "example": "番茄"
          },
          "num": {
            "type": "string",
            "example": "3个"
          },
          "category": {
            "type": "string",
            "example": "蔬菜"
          },
          "price": {
            "type": "string",
            "example": "6"
          },
          "done": {
            "type": "boolean",
            "example": false
          }
        },
        "additionalProperties": true
      },
      "DeviceResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "device": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "example": "dev_abc"
                  }
                },
                "additionalProperties": true
              },
              "deviceSecret": {
                "type": "string",
                "example": "只返回一次的密钥"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "CreateFamilyResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "family": {
                "$ref": "#/components/schemas/Family"
              },
              "familySecret": {
                "type": "string",
                "example": "家庭密钥，只返回一次"
              },
              "member": {
                "$ref": "#/components/schemas/Member"
              },
              "invite": {
                "$ref": "#/components/schemas/Invite"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "FamilyResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Family"
          }
        }
      },
      "InviteResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Invite"
          }
        }
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Member"
          }
        }
      },
      "MembersResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          }
        }
      },
      "CollectionChangesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "familyCode": {
                "type": "string",
                "example": "fam_xxx"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CollectionItem"
                }
              },
              "serverTime": {
                "type": "integer",
                "format": "int64",
                "example": 1778482043966
              }
            },
            "additionalProperties": true
          }
        }
      },
      "FamilyDataResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "familyRecipe": {
                "type": "object",
                "nullable": true,
                "additionalProperties": true
              },
              "shoppingList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CollectionItem"
                }
              },
              "ingredientLibrary": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CollectionItem"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "GenericDataResponse": {
        "type": "object",
        "properties": {
          "data": {
            "nullable": true,
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "familyCode is required"
          }
        }
      }
    }
  }
}
