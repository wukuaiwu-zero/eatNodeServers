{
  "openapi": "3.0.3",
  "info": {
    "title": "家庭厨房 Node API",
    "version": "1.0.0",
    "description": "Apifox 导入用接口文件。除注册设备接口外，其余接口通常需要 X-Device-Id 和 X-Device-Secret 请求头。"
  },
  "servers": [
    {
      "url": "http://lw.fyaigpt.cyou",
      "description": "线上 Nginx 域名"
    },
    {
      "url": "http://127.0.0.1:3000",
      "description": "本地开发服务"
    }
  ],
  "tags": [
    {
      "name": "设备"
    },
    {
      "name": "家庭"
    },
    {
      "name": "家庭成员"
    },
    {
      "name": "家庭菜谱"
    },
    {
      "name": "购物清单"
    },
    {
      "name": "食材库"
    },
    {
      "name": "聚合数据"
    }
  ],
  "paths": {
    "/api/registerDevice": {
      "post": {
        "tags": [
          "设备"
        ],
        "summary": "注册匿名设备",
        "description": "请求体可为空。服务端会生成或复用设备 ID 和密钥。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDeviceRequest"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                },
                "example": {
                  "data": {
                    "device": {
                      "deviceId": "dev_abc"
                    },
                    "deviceSecret": "只返回一次的密钥"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/createFamily": {
      "post": {
        "tags": [
          "家庭"
        ],
        "summary": "创建家庭",
        "security": [
          {
            "deviceAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFamilyRequest"
              },
              "example": {
                "familyName": "苏明明的厨房"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateFamilyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/getFamily": {
      "get": {
        "tags": [
          "家庭"
        ],
        "summary": "查询家庭",
        "security": [
          {
            "deviceAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/FamilyCodeQuery"
